project:
  worktreeBase: .worktrees
source:
  type: git
  git:
    remote: origin
    fetchPrune: true
    # Optional: repo-relative files/dirs (globs allowed, ** supported)
    # copied from the repo root into each new worktree on `add`.
    # Missing sources skip with a warning; existing files are never
    # overwritten. Example:
    # copy: [".env.local", "certs/", "storage/*.sqlite"]
runner:
  type: docker
  docker:
    composeFiles: [docker-compose.yml]
    # Optional: compose project is <prefix>-<slug>; empty/missing means
    # slug-only (e.g. `projectPrefix: ""`). Slug-only names can collide
    # across repos sharing a daemon.
    projectPrefix: demo
  # Alternative backend (set runner.type: podman and use `podman compose`
  # in entry.*):
  # podman:
  #   composeFiles: [docker-compose.yml]
  #   projectPrefix: demo
entry:
  setup: ["docker compose up --wait --build"]
  run: "docker compose logs -f"
  stop: "docker compose down"
  logs: "docker compose logs -f"
  reload: ["docker compose restart app"]
ports:
  base: {app: 8000}
  ranges:
    app: [8000, 8099]
# Health checks (optional, display-only): each `run` executes via `sh -c`
# with cwd=worktree and env=allocated ports (like entry.*). A running
# worktree shows `running (healthy)` when all pass, `running (degraded 1/2)`
# when some pass, `running (unhealthy)` when none pass. Compose containers
# with a `healthcheck:` are probed automatically with no config. Failures
# never fail `up` and never persist to the state file.
# health:
#   checks:
#     - name: api
#       run: "curl -sf http://localhost:${APP_PORT}/healthz"
#       timeout: 10s  # optional, default 10s (1s-120s)
# Local gateway: http://<slug>.localhost:8080 -> app port (stdlib reverse
# proxy, no extra dependencies). Opt-in: `up`/`add`/dashboard ensure the
# gateway when enabled, each worktree gains an append-only APP_URL in its
# .env, and `status` grows a URL column (the dashboard always shows one). Chrome/Firefox/Edge resolve .localhost with
# no setup; Safari/curl need `wrk3 proxy hosts-sync` (sudo for /etc/hosts).
proxy:
  enabled: false
  domain: localhost
  addr: 127.0.0.1:8080
